{
  "id": "desktop-lyric-styler",
  "name": "桌面歌词浮窗",
  "version": "1.4.0",
  "description": "复刻主程序桌面歌词样式的浮窗：当前行大号 + 一行副歌词，支持字体/字号、已播放与未播放颜色、逐词高亮与翻译。",
  "author": "EchoMusic User",
  "icon": "icon.svg",
  "main": "index.js",
  "requires": {
    "echoMusicVersion": ">=2.2.6-beta.20"
  },
  "contributes": {
    "windows": [
      {
        "id": "lyric",
        "type": "floating",
        "title": "桌面歌词",
        "main": "window.js",
        "style": "window.css",
        "defaultWidth": 720,
        "defaultHeight": 190,
        "minWidth": 300,
        "minHeight": 96,
        "maxWidth": 1200,
        "maxHeight": 800,
        "position": "bottom-center",
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "movable": true,
        "allowOutsideWorkArea": true,
        "acceptFirstMouse": true,
        "rememberBounds": true
      }
    ]
  }
}
